# Token da conta gratuita (tier Hobby) em https://app.localstack.cloud -> Workspace -> Auth Token
LOCALSTACK_AUTH_TOKEN=

# Nome do banco Postgres local compartilhado pelos serviços (um schema por serviço, D-01)
POSTGRES_DB=orderflow

# Usuário do Postgres local
POSTGRES_USER=orderflow

# Senha do Postgres local — qualquer string não vazia, só existe dentro do docker-compose local
POSTGRES_PASSWORD=
