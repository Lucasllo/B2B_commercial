<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.orderflow</groupId>
        <artifactId>orderflow-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>order-service</artifactId>
    <packaging>jar</packaging>
    <name>order-service</name>
    <description>Serviço dono do agregado pedido e da regra de crédito — cria pedidos a partir do catálogo e decide aprovação automática por limite de crédito sob trava por empresa, resource server apenas (nunca emite JWT)</description>

    <dependencies>
        <!-- Expõe os endpoints REST /orders e fornece o RestClient de saída para auth-service/
             catalog-service — vem no próprio spring-web, nenhuma dependência nova para chamada HTTP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Núcleo do Spring Security — SecurityFilterChain, @PreAuthorize -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Valida JWTs localmente via jwk-set-uri do auth-service, sem chamada síncrona por requisição (D-03) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Mapeamento JPA das tabelas orders/order_items/company_credit_lock do schema order -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Jakarta Bean Validation (@NotEmpty, @NotNull, @Positive) nos DTOs de entrada -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Expõe /actuator/health, consumido pelo healthcheck do docker-compose -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Gera o spec OpenAPI 3 e serve a Swagger UI na porta do próprio serviço -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- Motor de migração de schema — dono do schema order; Hibernate só valida (ddl-auto=validate) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Driver específico do Postgres para o Flyway (necessário desde o Flyway 10) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Driver JDBC do PostgreSQL, único banco transacional deste serviço (D-01) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Reduz boilerplate (getters/construtores) nas entidades -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
          SqsTemplate (produtor, usado só pelo OutboxRelay) e @SqsListener (consumidor, chega em
          05-03) para a saga de reserva de estoque (ORD-04). Já provado em inventory-service e
          notification-service desde a Fase 3 — sem versão, vem do BOM
          io.awspring.cloud:spring-cloud-aws-dependencies importado no pom raiz.
        -->
        <dependency>
            <groupId>io.awspring.cloud</groupId>
            <artifactId>spring-cloud-aws-starter-sqs</artifactId>
        </dependency>

        <!-- Dependências de teste -->
        <!-- MockMvc, AssertJ, JUnit 5 e Mockito para os testes de integração -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Integração JUnit 5 + ciclo de vida dos containers Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Container PostgreSQL real usado por AbstractIntegrationTest e pelas classes de socket
          real (CreditLimitBoundaryConcurrencyIT). Nenhuma dependência de @ServiceConnection
          (spring-boot-testcontainers) — o registro das propriedades de datasource é feito à mão
          via @DynamicPropertySource em OrderTestInfrastructure, para que classes com MockMvc e
          classes de socket real compartilhem o mesmo container singleton.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Container LocalStack real usado por ReservationCommandPublishingIT — Spring Cloud AWS
          não oferece @ServiceConnection para LocalStack (03-RESEARCH.md Pitfall A), as
          propriedades são registradas à mão via @DynamicPropertySource, mesmo padrão já provado em
          inventory-service/notification-service.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Asserções assíncronas de espera de provisionamento do LocalStack e leitura da fila -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>order-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
