<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reactor Maven pai do OrderFlow. Não usa spring-boot-starter-parent: os BOMs são importados
  explicitamente em dependencyManagement para manter controle total sobre a árvore de
  dependências dos cinco microsserviços que este reactor vai hospedar (Fases 1 a 6).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.orderflow</groupId>
    <artifactId>orderflow-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OrderFlow Parent</name>
    <description>Reactor Maven agregador dos microsserviços do OrderFlow</description>

    <modules>
        <module>gateway</module>
        <module>auth-service</module>
        <module>catalog-service</module>
        <module>inventory-service</module>
        <module>notification-service</module>
        <module>order-service</module>
        <!-- Módulo só de teste do Success Criteria 5 (E2E da saga, D-68) — sobe order-service e
             inventory-service como dois contextos Spring no mesmo JVM, sem código de produção
             próprio (sem src/main). -->
        <module>e2e-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- SPRING_BOOT_LINE registrado em 01-01-SUMMARY.md — decisão travada por checkpoint humano -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- SPRING_CLOUD_TRAIN registrado em 01-01-SUMMARY.md — trem compatível com spring-boot.version -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- Versão do BOM do Testcontainers usada pelos testes de integração de todos os módulos -->
        <testcontainers.version>1.20.4</testcontainers.version>
        <!-- Versão do Lombok usada por todos os módulos para reduzir boilerplate de entidades/DTOs -->
        <lombok.version>1.18.34</lombok.version>
        <!--
          Versão do springdoc-openapi (Swagger UI + spec OpenAPI 3). Diferente de Flyway/Lombok/
          Postgres, este artefato NÃO é gerenciado pelo BOM do Spring Boot acima — a versão precisa
          ser fixada aqui à mão. 2.9.1 é o topo da linha 2.x no Maven Central, alinhado à
          spring-boot.version 3.5.16 deste reactor (a linha 3.x do springdoc é para Spring Boot 4.0,
          fora da stack deste projeto).
        -->
        <springdoc.version>2.9.1</springdoc.version>
        <!-- Versão do maven-failsafe-plugin, que roda as classes *IT.java em ./mvnw verify -->
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
        <!--
          Versão do Spring Cloud AWS usada pelo notification-service (starters SQS/DynamoDB). A
          linha 4.x exige Spring Boot 4.0; 3.4.x é a última linha compatível com a
          spring-boot.version 3.5.16 e o trem spring-cloud.version 2025.0.3 fixados acima
          (03-RESEARCH.md §Standard Stack).
        -->
        <spring-cloud-aws.version>3.4.2</spring-cloud-aws.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM oficial do Spring Boot — fixa as versões de todos os starters/auto-configurações -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- BOM do Spring Cloud, trem Northfields, compatível com a linha Spring Boot acima -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- BOM do Testcontainers — usado pelos módulos de testes de integração (Postgres real) -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Gera o spec OpenAPI 3 e serve a Swagger UI — versão fixada aqui, não vem de nenhum BOM -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!--
              BOM do Spring Cloud AWS — gerencia os starters SQS/DynamoDB do notification-service e
              a versão do AWS SDK v2 que o próprio Spring Cloud AWS testou. Nenhum módulo deve
              declarar versão do software.amazon.awssdk à mão.
            -->
            <dependency>
                <groupId>io.awspring.cloud</groupId>
                <artifactId>spring-cloud-aws-dependencies</artifactId>
                <version>${spring-cloud-aws.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Empacota cada módulo como jar executável Spring Boot. A execução do goal
                  `repackage` é declarada explicitamente porque este reactor não herda de
                  spring-boot-starter-parent (BOMs são importados manualmente acima), então o
                  binding automático de `repackage` na fase `package` não é herdado por padrão.
                  `classifier=exec` mantém o jar plano (auth-service.jar) como artefato principal
                  — se repackage substituísse o artefato principal pelo jar gordo, o
                  maven-failsafe-plugin (que roda depois, na fase integration-test) montaria o
                  classpath de teste a partir do jar gordo, cujas classes vivem em BOOT-INF/classes
                  e não na raiz do jar — um NoClassDefFoundError para toda classe da aplicação.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                            <configuration>
                                <classifier>exec</classifier>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!--
                  Compilador Java 21 com o annotation processor path do Lombok configurado por
                  módulo. `<parameters>true</parameters>` é obrigatório a partir do Spring 6/Boot
                  3 (este reactor não herda de spring-boot-starter-parent, que já ativaria essa
                  flag por padrão): sem ela, nem `@PathVariable UUID companyId` nem o SpEL
                  `#companyId` de `@PreAuthorize` conseguem resolver o nome do parâmetro via
                  reflection, e a requisição falha com 500 em vez do 403/404 esperado (plano
                  01-05, Task 1 — descoberto pelos testes de `CompanyControllerIT`, Rule 3).
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <!--
                  Failsafe roda as classes *IT.java (integration-test + verify) — mantém os testes
                  de integração fora de `./mvnw test` (que só roda o surefire, *Test.java) e dentro
                  de `./mvnw verify`, conforme a convenção de nomes desta fase.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
